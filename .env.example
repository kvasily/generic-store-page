# Automatic desktop setup: use electrum.local.json instead; no .env is required.
# npm start always enables Bitcoin checkout, including with old demo settings.
# ELECTRUM_EXECUTABLE=/custom/path/to/installed/electrum
# ELECTRUM_AUTOSTART=false  # only to opt out of automatic desktop setup
PAYMENT_MODE=electrum
PORT=8080
SHOP_ORIGIN=http://127.0.0.1:8080
DATA_DIR=./data
# Keep authenticated Electrum RPC on loopback; do not publish it via Tor/nginx.
ELECTRUM_RPC_URL=http://127.0.0.1:7777
ELECTRUM_RPC_USER=
ELECTRUM_RPC_PASSWORD=
# Absolute path as seen by the Electrum daemon.
ELECTRUM_WALLET=
# Master PUBLIC key of the dedicated shop wallet. Never a seed or private key.
ELECTRUM_MASTER_PUBLIC_KEY=
# Set true only after creating a watch-only server wallet from that public key.
ELECTRUM_WATCH_ONLY=false
ELECTRUM_NETWORK=mainnet
BTC_MIN_CONFIRMATIONS=3
BTC_CHECKOUT_MINUTES=60
